/* The kit's screens: the terminal's own colours everywhere, no painted backgrounds. */

Screen {
    layout: vertical;
    background: transparent;
}

#header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: transparent;
}

#body {
    height: 1fr;
    background: transparent;
}

#plan {
    width: 36%;
    min-width: 24;
    max-width: 48;
    border: round $foreground 30%;
    border-title-color: $foreground;
    padding: 0 1;
    background: transparent;
    scrollbar-size: 1 1;
}

#plan Static {
    height: auto;
    background: transparent;
}

#log {
    border: round $foreground 30%;
    padding: 0 1;
    height: 1fr;
    background: transparent;
    scrollbar-size: 1 1;
}

#log Static {
    height: auto;
    background: transparent;
}

ModalScreen {
    align: center middle;
    background: transparent;
}

#dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $foreground 50%;
    background: transparent;
    padding: 1 2;
}

#dialog Label {
    width: 100%;
    background: transparent;
}

#title {
    text-style: bold;
    margin-bottom: 1;
}

#hint {
    color: $foreground 60%;
    margin-top: 1;
}

#choices {
    height: auto;
    max-height: 20;
    background: transparent;
}

#choices:focus {
    background: transparent;
}

#buttons {
    height: auto;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
}

Toast {
    background: transparent;
}
