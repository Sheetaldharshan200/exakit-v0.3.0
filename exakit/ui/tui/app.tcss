/* The kit's screens: the terminal's own colours everywhere, no painted backgrounds. */

Screen {
    layout: vertical;
    background: transparent;
}

#header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: transparent;
}

#body {
    height: 1fr;
    background: transparent;
}

#plan {
    width: 36%;
    min-width: 24;
    max-width: 48;
    border: round $foreground 30%;
    border-title-color: $foreground;
    padding: 0 1;
    background: transparent;
    scrollbar-size: 1 1;
}

#plan Static {
    height: auto;
    background: transparent;
}

#log {
    border: round $foreground 30%;
    padding: 0 1;
    height: 1fr;
    background: transparent;
    scrollbar-size: 1 1;
}

#log Static {
    height: auto;
    background: transparent;
}

ModalScreen {
    align: center middle;
    background: transparent;
}

#dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $foreground 50%;
    background: transparent;
    padding: 1 2;
}

#dialog Label {
    width: 100%;
    background: transparent;
}

#title {
    text-style: bold;
    margin-bottom: 1;
}

#hint {
    color: $foreground 60%;
    margin-top: 1;
}

#choices {
    height: auto;
    max-height: 20;
    background: transparent;
}

#choices:focus {
    background: transparent;
}

#buttons {
    height: auto;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
}

Toast {
    background: transparent;
}

/* --- the dashboard --- */

#search {
    height: auto;
    padding: 0 1;
    background: transparent;
}

#search-input {
    background: transparent;
    border: round $foreground 30%;
}

#search-input:focus {
    border: round $foreground 60%;
}

#results {
    height: auto;
    max-height: 10;
    border: round $foreground 30%;
    background: transparent;
}

.hidden {
    display: none;
}

#sidebar {
    width: 24;
    border: round $foreground 30%;
    background: transparent;
    padding: 0 1;
}

#sidebar ListItem, .entries ListItem {
    background: transparent;
    padding: 0 1;
}

#content {
    height: 1fr;
    border: round $foreground 30%;
    padding: 0 1;
    background: transparent;
}

#view {
    height: 1fr;
    background: transparent;
}

.entries {
    width: 36%;
    min-width: 24;
    max-width: 44;
    border-right: solid $foreground 20%;
    background: transparent;
}

.detail {
    height: 1fr;
    padding: 0 2;
    background: transparent;
}

.detail-text {
    height: auto;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button, .detail Button {
    margin-right: 2;
    margin-top: 1;
}

TabbedContent, TabPane, Tabs, ContentSwitcher {
    background: transparent;
}

Footer {
    background: transparent;
}

OptionList > .option-list--option-highlighted, ListView > ListItem.-highlight {
    background: $foreground 15%;
    text-style: bold;
}

#cards {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    height: auto;
    margin-top: 1;
    background: transparent;
}

.card {
    height: auto;
    border: round $foreground 30%;
    padding: 0 1;
    background: transparent;
}

.card-title, .card-text {
    height: auto;
    background: transparent;
}

.card-actions {
    height: auto;
    margin-top: 1;
}

.card-actions Button {
    margin-right: 1;
}
